<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Node.Lib</RootNamespace>
    <PackageId>Node.Lib</PackageId>
    <Description>The pieces a per-user local node shares with its clients: where its Unix domain socket and data folder are, the lock that admits one node to a socket, and an HTTP handler that connects through the socket. BCL only, AOT/trim friendly.</Description>
    <PackageTags>Node;UnixDomainSocket;Socket;Lock;LocalServer;IPC</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- No version properties here: they derive from VersionMajorMinor in the repo-root Directory.Build.props, and CI
         composes the package version from it. Bump it THERE. -->
    <Authors>Sebastian Godelet</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/Node.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Node.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
